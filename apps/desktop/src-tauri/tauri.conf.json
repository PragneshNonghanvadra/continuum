{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Continuum",
  "version": "0.1.0",
  "identifier": "dev.continuum.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bash ../../scripts/build-tauri-sidecars.sh && bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Continuum",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/continuum-native-capture"
    ],
    "icon": []
  }
}
